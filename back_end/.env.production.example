# Production environment template (development-phase foundation)
# Copy to `.env` (or set env vars directly) and fill in required values.

APP_ENV=production
DEBUG=false

# Required when DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Use PostgreSQL.
DB_NAME=futsaldb
DB_USER=postgres
DB_PASSWORD=Ahmadi123
DB_HOST=localhost
DB_PORT=5432
# Optional override:
# DATABASE_URL=postgres://postgres:Ahmadi123@localhost:5432/futsaldb

# CORS (adjust for your frontend domains)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# --- Stripe (DO NOT switch mode yet) ---
# Keep test keys until you intentionally move to live Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=AFN

# Security hardening (turn these on when you are behind HTTPS)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=true

