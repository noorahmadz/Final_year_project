# Copy this file to `.env` in the same directory (`Futsal_project/back_end/`) and adjust values.
# `.env` is gitignored — never commit real secrets.

# --- Development (typical local) ---
APP_ENV=development
DEBUG=true
# Optional when DEBUG=true: omit SECRET_KEY to use a fixed dev fallback in settings (localhost only).
# For staging/shared dev servers, set a long random value, e.g. `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=

# Database
DB_NAME=futsaldb
DB_USER=postgres
DB_PASSWORD=Ahmadi123
DB_HOST=localhost
DB_PORT=5432
# Optional override:
# DATABASE_URL=postgres://postgres:Ahmadi123@localhost:5432/futsaldb

# CORS (e.g. React/Vite on another port)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false

# Logging
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# --- Stripe (TEST MODE — expected in development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=AFN

# --- Hardening (enable when testing behind HTTPS / real domains; leave off for plain http localhost) ---
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false
