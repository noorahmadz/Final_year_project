# Staging environment template
# Copy to `.env` (or set env vars directly) and fill in required values.

APP_ENV=staging
DEBUG=false

# Required when DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=sqlite:///db.sqlite3

# CORS (if needed for your frontend)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# --- Stripe (TEST MODE expected during development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=AFN

# Security hardening: keep TLS flags off unless you are behind HTTPS in staging.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false

